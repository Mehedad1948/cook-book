{
  "name": "cook-book",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "recipes:index": "tsx scripts/gen-index.ts",
    "validate:recipes": "npm run recipes:index && tsx scripts/validate-recipes.ts",
    "predev": "npm run recipes:index",
    "prebuild": "npm run validate:recipes",
    "test": "tsx --test tests/*.test.ts",
    "check:leaks": "tsx scripts/check-leaks.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}